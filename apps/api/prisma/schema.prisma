generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  CAPTAIN
  GROUND_OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model User {
  id             String          @id @default(cuid())
  name           String
  phone          String          @unique
  teamName       String?
  captainQrData  String?
  role           UserRole?
  createdAt      DateTime        @default(now())
  bookings       MatchBooking[]
  locks          ScheduleLock[]  @relation("PlayerLocks")
  captainLocks   ScheduleLock[]  @relation("CaptainLocks")
  captainMatches Match[]         @relation("CaptainMatches")
  captainTeams   Team[]          @relation("TeamCaptain")
  teamMemberships TeamMember[]
}

model Team {
  id        String       @id @default(cuid())
  name      String
  captainId String       @unique
  captain   User         @relation("TeamCaptain", fields: [captainId], references: [id])
  members   TeamMember[]
  createdAt DateTime     @default(now())
}

model TeamMember {
  id           String   @id @default(cuid())
  teamId       String
  userId       String?
  invitedPhone String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  @@unique([teamId, invitedPhone])
  @@index([userId])
}

model Match {
  id          String          @id @default(cuid())
  title       String
  ground      String?
  startsAt    DateTime
  endsAt      DateTime
  captainId   String
  totalFee    Float?
  feeSettled  Boolean         @default(false)
  captain     User            @relation("CaptainMatches", fields: [captainId], references: [id])
  bookings    MatchBooking[]
  createdAt   DateTime        @default(now())
}

model MatchBooking {
  id                    String        @id @default(cuid())
  matchId               String
  playerId              String
  status                BookingStatus @default(PENDING)
  feeAmount             Float         @default(0)
  feePaid               Boolean       @default(false)
  paymentMarkedByPlayer Boolean       @default(false)
  paymentMarkedAt       DateTime?
  match                 Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player                User          @relation(fields: [playerId], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  @@unique([matchId, playerId])
  @@index([playerId, status])
  @@index([playerId, feePaid])
}

model ScheduleLock {
  id          String   @id @default(cuid())
  playerId    String
  captainId   String?
  title       String
  startsAt    DateTime
  endsAt      DateTime
  source      String   @default("PLAYER")
  status      String   @default("LOCKED")
  player      User     @relation("PlayerLocks", fields: [playerId], references: [id], onDelete: Cascade)
  captain     User?    @relation("CaptainLocks", fields: [captainId], references: [id])
  createdAt   DateTime @default(now())
  @@index([playerId, startsAt, endsAt])
}
